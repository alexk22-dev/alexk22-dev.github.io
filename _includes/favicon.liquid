{% if site.icon != blank %}
  {% assign icon_lower = site.icon | downcase %}
  {% if icon_lower contains '.svg' or icon_lower contains '.png' or icon_lower contains '.jpg' or icon_lower contains '.jpeg' or icon_lower contains '.webp' or icon_lower contains '.ico' %}
    {% assign icon_path = site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache %}
    <link rel="icon" type="image/svg+xml" href="{{ icon_path }}" sizes="any">
    <link rel="shortcut icon" href="{{ icon_path }}">
    <link rel="apple-touch-icon" href="{{ icon_path }}">
  {% else %}
    <link
      rel="shortcut icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
    >
  {% endif %}
{% endif %}
